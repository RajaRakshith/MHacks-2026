# Copy to .env. With MOCK=1 nothing below the first block is needed.

# --- Core ---
# MOCK=1 runs the whole demo from fixtures: no Twilio, ElevenLabs, Gemini, or Nessie keys.
MOCK=1
SPACETIME_URI=ws://127.0.0.1:3000
SPACETIME_DB=scamshield

# --- Nessie (Capital One hackathon API) ---
NESSIE_KEY=
NESSIE_BASE=https://prod-api.nessieisreal.com

# --- Gemini (call analyzer) ---
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# --- ElevenLabs (streaming speech-to-text) ---
ELEVENLABS_API_KEY=

# --- Twilio (live calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The ScamShield number, E.164 (+1...)
TWILIO_NUMBER=
# The customer's phone that /protect rings, E.164
CUSTOMER_PHONE=
# Public https URL of the relay (ngrok), no trailing slash
PUBLIC_URL=

# --- Optional ---
# Port the relay listens on.
RELAY_PORT=8787
# Token of the identity that published the module. `pnpm dev` fills this in
# for the relay; set it only when you run the relay on its own.
SPACETIME_TOKEN=
# Serial port of the FREE-WILi display processor, for example /dev/ttyACM1.
FREEWILI_PORT=

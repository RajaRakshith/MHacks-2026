# ScamShield — copy to .env at the repo root (never commit .env).
# Read by scamshield-bridge (call server), worker/ (Nessie transfers) and server/ (alt TS ingestion server).

# ---------- SpacetimeDB ----------
# Local: `spacetime start` serves on :3000. Maincloud: wss://maincloud.spacetimedb.com + SPACETIME_DATABASE=scamshield
SPACETIME_URI=ws://127.0.0.1:3000
SPACETIME_DATABASE=scamshield-dev
# SPACETIME_TOKEN=

# ---------- Call server (scamshield-bridge) ----------
PORT=8080
# Your ngrok URL, e.g. https://abc123.ngrok-free.app. Leave blank to use the request's Host header.
PUBLIC_URL=
# Must match the userId the bank app passes to request_transfer, or the money gate won't see the call
DEFAULT_USER_ID=demo-user

GROK_CONNECT_TIMEOUT_MS=5000
# inbound = audio coming INTO the ScamShield leg (the merged call)
TWILIO_TRACK=inbound

# ---------- Twilio ----------
TWILIO_AUTH_TOKEN=

# ---------- xAI (Grok) — console.x.ai -> API Keys ----------
XAI_API_KEY=
# Grok Voice realtime model (live transcript only)
XAI_MODEL=grok-voice-latest
# server/ only
XAI_CHAT_MODEL=grok-4-fast-non-reasoning
# Used only by server/
XAI_STT_MODEL=grok-voice-transcribe-2.0

# ---------- Gemini (risk score on each Grok transcript flush) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_TIMEOUT_MS=8000

# ---------- ElevenLabs — elevenlabs.io -> Settings -> API Keys (Text to Speech warning (bridge). server/ still uses Scribe realtime.) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_LANGUAGE=en
ELEVENLABS_DIARIZE=true
# Realtime STT model, used only by server/
ELEVENLABS_STT_MODEL=scribe_v2_realtime

# Spoken warning injected into the call once risk >= TTS_WARNING_SCORE (TTS_WARNING=false to disable)
TTS_WARNING=true
TTS_WARNING_SCORE=85
ELEVENLABS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
SCAM_WARNING_TEXT=This is a scam call, please hang up.

# ---------- server/ only ----------
STT_FAILOVER_MS=5000
RISK_MIN_CHARS=12

# ---------- Nessie (Capital One mock bank — transfer worker) ----------
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

# ScamShield — copy to .env at the repo root (never commit .env).
# Bridge/worker/server read this file. The C1 Mockup dashboard also reads it.

# MOCK=1 runs the dashboard demo from fixtures (no live Twilio/Gemini/Nessie keys).
# MOCK=0 uses real APIs. The live call bridge always needs the keys below.
MOCK=1

# ---------- SpacetimeDB ----------
# Local: `spacetime start` serves on :3000. Maincloud: wss://maincloud.spacetimedb.com
# Bridge/worker use SPACETIME_DATABASE; dashboard `pnpm dev` also reads SPACETIME_DB.
SPACETIME_URI=ws://127.0.0.1:3000
SPACETIME_DATABASE=scamshield-dev
SPACETIME_DB=scamshield
# SPACETIME_TOKEN=

# ---------- Call server (scamshield-bridge) ----------
PORT=8080
# Free static ngrok hostname (claim once at https://dashboard.ngrok.com/domains). Used by `npm run tunnel`.
NGROK_DOMAIN=
# Same host, with https:// — TwiML uses this so the Media Stream URL stays stable.
PUBLIC_URL=
# Must match the userId the bank app passes to request_transfer, or the money gate won't see the call
DEFAULT_USER_ID=demo-user

GROK_CONNECT_TIMEOUT_MS=5000
# inbound = audio coming INTO the ScamShield leg (the merged call)
TWILIO_TRACK=inbound

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The ScamShield number, E.164 (+1...)
TWILIO_NUMBER=
# The customer's phone that /protect rings, E.164
CUSTOMER_PHONE=

# ---------- xAI (Grok) — console.x.ai -> API Keys ----------
XAI_API_KEY=
# Grok Voice realtime model (live transcript only)
XAI_MODEL=grok-voice-latest
# server/ only
XAI_CHAT_MODEL=grok-4-fast-non-reasoning
# Used only by server/
XAI_STT_MODEL=grok-voice-transcribe-2.0

# ---------- Gemini (risk score on each Grok transcript flush) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_TIMEOUT_MS=8000

# ---------- ElevenLabs — elevenlabs.io -> Settings -> API Keys (TTS warning on the bridge; Scribe on server/relay) ----------
ELEVENLABS_API_KEY=
# Realtime STT model, used only by server/
ELEVENLABS_STT_MODEL=scribe_v2_realtime

# Spoken warning injected into the call once risk >= TTS_WARNING_SCORE (TTS_WARNING=false to disable)
TTS_WARNING=true
TTS_WARNING_SCORE=85
ELEVENLABS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
SCAM_WARNING_TEXT=This is ScamShield, protecting your calls. This is a scam. Hang up now.

# ---------- server/ only ----------
STT_FAILOVER_MS=5000
RISK_MIN_CHARS=12

# ---------- Nessie (Capital One mock bank) ----------
# Bridge worker uses NESSIE_API_KEY / NESSIE_BASE_URL. Dashboard seed uses NESSIE_KEY / NESSIE_BASE.
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
NESSIE_KEY=
NESSIE_BASE=https://prod-api.nessieisreal.com

# ---------- Dashboard / relay ----------
RELAY_PORT=8787
# Serial port of the FREE-WILi display processor, for example /dev/ttyACM1.
FREEWILI_PORT=

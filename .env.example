# SpacetimeDB — copy to .env (never commit .env)
SPACETIME_URI=ws://127.0.0.1:3000
SPACETIME_DATABASE=scamshield-dev
# SPACETIME_TOKEN=

# Ingestion server
PORT=8080
PUBLIC_URL=https://your-ngrok-url.ngrok.io

# Twilio
TWILIO_AUTH_TOKEN=

# xAI — primary STT + risk scoring
XAI_API_KEY=
XAI_STT_MODEL=grok-voice-transcribe-2.0
XAI_CHAT_MODEL=grok-2-1212

# ElevenLabs — backup STT
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime

# STT failover: switch to ElevenLabs if Grok idle/errors (ms)
STT_FAILOVER_MS=5000
RISK_MIN_CHARS=12

# Nessie (Capital One mock bank — transfer worker)
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

PORT=8080
# Public host Twilio should stream to (your ngrok host, no scheme). Optional — defaults to the request's Host header.
PUBLIC_HOST=
# userId sent to SpacetimeDB when the webhook URL has no ?userId= (falls back to the caller's number)
DEFAULT_USER_ID=

# Primary engine: grok | elevenlabs
STT_ENGINE=grok
# If Grok can't connect / errors / drops mid-call, switch that call to ElevenLabs
FAILOVER=true
GROK_CONNECT_TIMEOUT_MS=5000

# xAI — console.x.ai -> API Keys
XAI_API_KEY=
XAI_MODEL=grok-voice-latest
# Text model that scores ElevenLabs transcripts after a failover
XAI_TEXT_MODEL=grok-4-fast-non-reasoning

# ElevenLabs — elevenlabs.io -> Settings -> API Keys (needs Speech to Text permission)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_LANGUAGE=en
ELEVENLABS_DIARIZE=true
# Seconds of audio per ElevenLabs request; lower = faster warnings, more requests
CHUNK_SECONDS=6
SILENCE_RMS=150

# SpacetimeDB
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=scamshield
# Optional: `spacetime login show --token`. Lets reducers check the caller is the bridge.
SPACETIME_TOKEN=
REDUCER_START=start_call
REDUCER_CHUNK=append_transcript
REDUCER_RISK=update_risk
REDUCER_END=end_call

# inbound = audio coming INTO the ScamShield leg (i.e. the merged call). Use outbound if your TwiML differs.
TWILIO_TRACK=inbound
